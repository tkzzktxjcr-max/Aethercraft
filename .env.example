# Ollama AI server (optional — falls back to local WebLLM if unreachable)
# Recommended models for CPU-only servers:
#   - qwen2.5:7b  (⭐ BEST quality/time ratio, ~5GB, 8-12s per combo)
#   - gemma2:2b   (fastest, ~2GB, 3-5s, quality OK for basic combos)
#   - phi3:3.8b   (balanced, ~3GB, 5-8s)
#   - llama3.1:8b (best quality, slowest, ~5GB, 10-15s)
VITE_OLLAMA_URL=https://ai.aethercraft.071098v2.duckdns.org/api/generate
VITE_OLLAMA_MODEL=qwen2.5:7b
